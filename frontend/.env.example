# URL của backend API khi chạy local (dev).
VITE_API_URL="http://localhost:4000/api"

# Khi deploy lên Vercel: đặt VITE_API_URL="/api" (đường dẫn tương đối), KHÔNG
# dùng URL đầy đủ của backend. Lý do: vercel.json cấu hình rewrite để Vercel
# tự proxy "/api/*" sang backend Render -> với trình duyệt, request luôn là
# same-origin (cùng domain vercel.app) -> cookie đăng nhập không bị chặn ở chế
# độ riêng tư/incognito (nhiều trình duyệt chặn cookie giữa 2 domain khác nhau).
