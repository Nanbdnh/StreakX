# PostgreSQL connection string (Neon, Railway, hoặc local Postgres)
DATABASE_URL="postgresql://user:password@host:5432/habit_tracker?schema=public"

# Bí mật để ký JWT - đổi thành chuỗi ngẫu nhiên dài khi deploy thật
JWT_SECRET="change-me-to-a-long-random-string"

# Thời gian sống của token, dùng cú pháp jsonwebtoken (vd: "7d", "1h")
JWT_EXPIRES_IN="7d"

# Cổng chạy server
PORT=4000

# Domain của frontend, dùng để cấu hình CORS + cookie
FRONTEND_ORIGIN="http://localhost:5173"

# Đặt "production" khi deploy để cookie dùng Secure + SameSite=None
NODE_ENV="development"
